# Talos 部署环境变量示例：复制为 .env 并填入实际值（.env 已被 .gitignore 忽略，切勿提交）

# JWT 签名密钥：必须为 >=32 字符的强随机值。生成方式：openssl rand -hex 32
VP_SECRET_KEY=

# PostgreSQL 凭证（docker-compose 使用）
POSTGRES_USER=vulnplatform
POSTGRES_PASSWORD=
POSTGRES_DB=vulnplatform

# 可选：内置 admin 初始口令。留空则首次启动随机生成并打印到容器日志（仅显示一次）
# VP_INITIAL_ADMIN_PASSWORD=

# 可选：允许携带凭证的跨域来源白名单（JSON 数组），默认 ["http://localhost","http://localhost:27014"]
# VPS 部署时若前端不经 Vite 代理直连后端，需加入实际访问地址，如 ["http://<VPS_IP>:27014"]
# VP_CORS_ORIGINS=["https://talos.example.com"]

# 可选：本地开发端口（dev.sh / dev.ps1 / vite.config.ts 使用），默认前端 27014、后端 27015
# 服务均绑定 0.0.0.0；VPS 外部访问只需放行前端端口（后端经 Vite 代理转发）
# FRONTEND_PORT=27014
# BACKEND_PORT=27015

# 可选：系统标准时区（IETF 名称，如 Asia/Shanghai），默认 UTC+8 北京时间
# VP_TIMEZONE=Asia/Shanghai

# 可选：调试模式。生产环境务必保持 false（false 时强制校验 VP_SECRET_KEY 且关闭 API 文档）
# VP_DEBUG=false

# 可选：目录域自动更新。
# 设为 1 时 worker 镜像会最小化安装 LibreOffice，导出 docx 后自动刷新目录（开箱即用）；
# 保持 0 则镜像更小，导出后前端会提示用户打开 Word 手动更新目录（右键目录 → 更新域，或 F9）
# ENABLE_LIBREOFFICE=0

# 可选：LibreOffice 单次目录更新超时（秒），默认 180。小服务器首次初始化较慢
# VP_LIBREOFFICE_TIMEOUT=180

# 可选：关闭 LibreOffice 自动更新（即使已安装），前端将提示手动更新目录
# VP_UPDATE_TOC_WITH_LIBREOFFICE=true
