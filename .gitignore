# ============================================================
# Talos .gitignore
# 原则：按类分组 + 通配模式优先，避免逐文件精确枚举——
#       新增调试脚本/日志/临时库时无需再修改本文件。
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[co]
.venv/
.pytest_cache/

# ---------- 数据库（本地 SQLite 及备份；dev.db 无路径前缀，覆盖各目录同名文件） ----------
dev.db
_devrun.db
test.db*
test_vp*.db
*.db-journal
*.db-wal
*.db-shm
*.db.bak*

# ---------- 本地存储与备份（含业务数据，勿入库） ----------
/storage/
backend/storage/
backend/_devstorage/
backend/tests/test_storage/
/backups/

# ---------- 前端（依赖与构建产物） ----------
node_modules/
dist/
frontend/dist_check/

# ---------- 日志（任意位置） ----------
*.log

# ---------- 环境变量 ----------
.env
.env.local

# ---------- 本地调试 / 排查产物（模式化） ----------
/_edgeprofile/
/_*.txt
/backend/_*.py
/backend/_*.txt
/backend/tmp_*.py
/backend/verify_*.py
frontend/_*.err

# ---------- 截图与样例文档（根目录；入库模板在 backend/app/templates/） ----------
/*.png
frontend/*.png
/*.docx

# ---------- UI 风格 Demo（本地设计稿，勿入库） ----------
design-demos/

# ---------- 本地 IDE / AI 工具配置 ----------
.qoder/
.codebuddy/
.workbuddy/
.zcode/
.idea/
.vscode/
