# ============================================================
# Talos .gitignore
# 原则：按类分组 + 通配模式优先，避免逐文件精确枚举——
#       新增调试脚本/日志/临时库时无需再修改本文件。
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[co]
.venv/
# venv 切换/回退时的备份目录（如 .venv.old310），避免误入库
.venv.*/
.pytest_cache/
# pytest 基线临时目录：受管终端下须以 --basetemp 指向仓库内固定目录（默认系统临时目录
# 会被删除守卫视为越界目标），故该目录会反复生成，勿入库。见 docs/LOCAL_DEV_SETUP.md 第四节
backend/_pytest_tmp/
# 覆盖率产物（pytest-cov；CI 会作为产物上传）
.coverage
coverage.xml
htmlcov/

# ---------- 端到端测试（Playwright，仓库根工具包） ----------
e2e-results/
e2e-report/
# E2E 栈专用 storage（与开发栈 backend/storage 隔离）
backend/storage_e2e/

# ---------- 数据库 ----------
# SQLite 专属忽略项（dev.db / _devrun.db / test.db* / test_vp*.db / *.db-*）
# 已随 2026-09-21「统一 PostgreSQL 单栈」收口移除；本地开发库现为 PostgreSQL。
# DBngin 本地数据目录（PostgreSQL/Redis 实例数据，含二进制文件，勿入库）
dev-database/

# ---------- 本地存储与备份（含业务数据，勿入库） ----------
/storage/
backend/storage/
backend/_devstorage/
backend/tests/test_storage/
/backups/

# ---------- 前端（依赖与构建产物） ----------
node_modules/
dist/
frontend/dist_check/

# ---------- 日志（任意位置） ----------
*.log

# ---------- 环境变量 ----------
.env
.env.local

# ---------- 本地调试 / 排查产物（模式化） ----------
/_edgeprofile/
/_*.txt
/backend/_*.py
/backend/_*.txt
/backend/tmp_*.py
/backend/verify_*.py
frontend/_*.err

# ---------- 截图与样例文档（根目录；入库模板在 backend/app/templates/） ----------
/*.png
frontend/*.png
/*.docx

# ---------- UI 风格 Demo（本地设计稿，勿入库） ----------
design-demos/

# ---------- 本地 IDE / AI 工具配置 ----------
.qoder/
.mimosa/
.codebuddy/
.workbuddy/
.zcode/
.idea/
.vscode/
